@page "/AttendanceForDay"
@attribute [Authorize]
@inject AttentanceService attendanceService
@inject BarberService barberService
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IJSRuntime JS


<div class="container mt-4 attendance-page">

    <div class="row align-items-center mb-4">

        <div class="col">

            <p class="page-kicker">العمليات اليومية</p>
            <h2 class="fw-bold text-dark">الحضور والغياب</h2>
            <p class="text-muted mb-0">راجع وسجل حضور فريقك في اليوم المحدد.</p>

        </div>

        <div class="col-auto attendance-filter">
            <label class="form-label">تاريخ الحضور</label>
            <InputDate @bind-Value="selectedDate"
                       max="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")"
                       @bind-Value:after="LoadAttendance"
                       class="form-control" />
            <button type="button" class="btn btn-primary" @onclick="LoadAttendance">
                بحث
            </button>
        </div>
       

    </div>

</div>




<div class="container attendance-content">
@if (!AtttendanceRecorded)
{
    <div class="card border-0 shadow-sm overflow-hidden">
    <table class="table mb-0">
        <thead>

            <tr>
                <th scope="col">الاسم</th>
                <th scope="col">الحالة</th>
                <th scope="col" class="text-center">غائب اليوم</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var _item in barberList)
            {
                <tr>
                    <td>@_item.Name</td>
                    @if (_item.StartDate > selectedDate)
                    {
                       
                        <td><span class="badge bg-secondary">لم يبدأ العمل</span></td>
                        <td></td>
                    }
                    else
                    {
                        <td><span class="badge bg-warning text-dark">غير مسجل</span></td>
                        
                        <td class="text-center"><InputCheckbox class="attendance-check" @bind-Value="_item.IsAbsentToday" /> </td>
                    }
                   

                </tr>
            }

        </tbody>


    </table>
    </div>
    @if (barberList.Any(b => b.StartDate <= selectedDate))
    {

        <button class="btn btn-success mt-3" @onclick="SaveAttendance">تسجيل الحضور</button>
    }
    else if (barberList.Any(b => b.StartDate > selectedDate))
    {
        <div class="alert alert-info mt-3">
            لا يوجد حلاقون بدأوا العمل في التاريخ المحدد أو قبله.
        </div>
    }

}
else
{
    <div class="card border-0 shadow-sm overflow-hidden">
    <table class="table mb-0">
        <thead>

            <tr>
                <th scope="col">الاسم</th>
                
                <th scope="col">الحالة</th>
                <th scope="col"></th>
                <th scope="col">    </th>

            </tr>
        </thead>
        <tbody>
            @foreach (var _item in attendanceList)
            {
                <tr>
                    <td>@_item.BarberName</td>
                   
                    @if (_item.Status == "Present")
                    {
                        <td><span class="badge bg-success">حاضر</span></td>
                        <td><button class="btn btn-sm btn-primary" @onclick="() => openEdit(_item.AttendanceId, _item.Status)">تعديل</button></td>
                    }
                    else if (_item.Status == "Absent")
                    {
                        <td><span class="badge bg-danger">غائب</span></td>
                        <td><button class="btn btn-sm btn-primary" @onclick="() => openEdit(_item.AttendanceId,_item.Status)">تعديل</button></td>
                    }
                    else
                    {
                        <td><span class="badge bg-warning text-dark">غير مسجل</span></td>
                        <td><button class="btn btn-success">حاضر</button></td>
                        <td><button class="btn btn-danger">غائب</button></td>
                    }
                    <td>
                        <NavLink href="@($"/barberAttendance/{_item.BarberId}")"
                                 class="btn btn-sm btn-success">
                            التفاصيل
                        </NavLink>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}




@if (!string.IsNullOrWhiteSpace(Massage))
{
        <div class="alert alert-danger mt-3">
            @Massage
        </div>
}
</div>





@if (showEdit == true)
{

    <div class="modal fade show d-block"
         style="background-color:rgba(0,0,0,.5)">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5>تعديل الحضور</h5>
                    <button class="btn-close"
                            @onclick="CloseEditBarberModal">
                    </button>
                </div>

                <div class="modal-body">

                    <EditForm Model="@attendanceD1" OnValidSubmit="EditAttend">

                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">
                                الحالة
                            </label>

                            <InputCheckbox @bind-Value="attendanceD1.IsPresent" />

                            <ValidationMessage For="@(() => attendanceD1.IsPresent)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">كلمة المرور</label>
                            <input type="password" class="form-control" @bind="checkAccess.pass" />
                            <ValidationMessage For="@(() => checkAccess.pass)" />
                        </div>

                        <div class="text-end">
                            <button type="button"
                                    class="btn btn-secondary me-2"
                                    @onclick="CloseEditBarberModal">
                                إلغاء
                            </button>

                            <button type="submit"
                                    class="btn btn-success">
                                حفظ
                            </button>
                        </div>

                    </EditForm>

                </div>

            </div>
        </div>
    </div>
}

<style>
    .page-kicker { color:#2563eb; font-size:.72rem; font-weight:700; letter-spacing:.1em; margin-bottom:.3rem; text-transform:uppercase; }
    .attendance-filter { display:flex; align-items:end; gap:.65rem; padding:.8rem; border:1px solid #e2e8f0; border-radius:12px; background:#fff; }
    .attendance-filter .form-label { margin:0; white-space:nowrap; }
    .attendance-filter .form-control { width:155px; }
    .attendance-content { padding-bottom:2rem; }
    .attendance-check { width:1.1rem; height:1.1rem; cursor:pointer; }
    @@media (max-width:640px) { .attendance-filter { align-items:stretch; flex-direction:column; width:100%; } .attendance-filter .form-control { width:100%; } }
</style>

@code {

    List<AttendanceMV> attendanceList = new List<AttendanceMV>();

    List<BarberMV> barberList = new List<BarberMV>();
    

    bool AtttendanceRecorded ;

    DateOnly selectedDate ;

    protected override async Task OnInitializedAsync()
    {
        selectedDate = DateOnly.FromDateTime(DateTime.Now);

        await LoadAttendance();


    }

    List<AttendanceD> attendanceD = new List<AttendanceD>();
    public async Task SaveAttendance()
    {
        foreach (var barber in barberList)
        {


            AttendanceD attendance = new AttendanceD
            {
                BarberId = barber.Id,
                IsPresent = barber.IsAbsentToday,
                DateOnly = selectedDate
            };

            attendanceD.Add(attendance);
        }

        await JS.InvokeVoidAsync("showLoading");

        var respons = await attendanceService.AddAttendance(attendanceD);

        await JS.InvokeVoidAsync("hideLoading");


        await LoadAttendance();

        attendanceD.Clear();

        if(respons.Status)
        {
            await JS.InvokeVoidAsync("showToast", respons.StatusMessage);

        }

        else
        {
            await JS.InvokeVoidAsync("showToast2", respons.StatusMessage);
        }




    }

    string Massage = string.Empty;

    private async Task LoadAttendance()
    {

        var respons = await attendanceService.GetAttendanceByDate(selectedDate);

        attendanceList = respons.attendances;

        if (attendanceList.Any())
        {
            AtttendanceRecorded = true;
        }
        else
        {
            barberList = await barberService.GetAllBarbers();
            AtttendanceRecorded = false;
        }

        if(!respons.apiRespons.Status)
        {
            await JS.InvokeVoidAsync("showToast2",respons.apiRespons.StatusMessage);
        }
    }

    //Edit
    string AttendiId = string.Empty;
    bool showEdit = false;
    CheckAccess checkAccess = new CheckAccess();

    AttendanceD attendanceD1 = new AttendanceD();
    public void openEdit(string id, string status)
    {

        AttendiId = id;
        attendanceD1.IsPresent = status == "Present";
        checkAccess = new CheckAccess();
        showEdit = true;


    }


    public void CloseEditBarberModal()
    {
        showEdit = false;
        checkAccess = new CheckAccess();

    }

    public async Task EditAttend()
    {
        await JS.InvokeVoidAsync("showLoading");
        var respons = await attendanceService.UpdateAttend(attendanceD1, AttendiId, checkAccess);
        await JS.InvokeVoidAsync("hideLoading");
        showEdit = false;

        await LoadAttendance();

        if (respons.Status)
        {
            await JS.InvokeVoidAsync("showToast", respons.StatusMessage);
        }
        else
        {
            await JS.InvokeVoidAsync("showToast2", respons.StatusMessage);
        }
    }
    

}
