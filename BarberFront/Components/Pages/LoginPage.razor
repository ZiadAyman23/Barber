@page "/login"
@attribute [AllowAnonymous]
@inject AccountService accountService
@inject IJSRuntime JS
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider authStateProvider

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<div class="login-wrapper">
    <div class="login-card">

        <div class="login-header">
            <div class="brand-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="6" cy="6" r="3" /><circle cx="6" cy="18" r="3" />
                    <line x1="20" y1="4" x2="8.12" y2="15.88" />
                    <line x1="14.47" y1="14.48" x2="20" y2="20" />
                    <line x1="8.12" y1="8.12" x2="12" y2="12" />
                </svg>
            </div>
            <h1 class="login-title">Welcome Back</h1>
            <p class="login-subtitle">Craft Barbershop</p>
        </div>

        <EditForm Model="@login" OnValidSubmit="_Login" FormName="loginForm" class="login-form">
            <DataAnnotationsValidator />

            <div class="field-group">
                <label class="field-label" for="nameInput">Username</label>
                <InputText id="nameInput"
                           class="field-input"
                           placeholder="Enter your username"
                           @bind-Value="login.Name" />
                <ValidationMessage For="@(() => login.Name)" class="field-error" />
            </div>

            <div class="field-group">
                <label class="field-label" for="passInput">Password</label>
                <div class="password-wrapper">
                    <input id="passInput"
                           type="@(showPassword ? "text" : "password")"
                           class="field-input"
                           placeholder="Enter your password"
                           @bind="login.Password"
                           @bind:event="oninput" />
                    <button type="button" class="toggle-pass" @onclick="() => showPassword = !showPassword" title="Toggle password">
                        @if (showPassword)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                            </svg>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        }
                    </button>
                </div>
                <ValidationMessage For="@(() => login.Password)" class="field-error" />
            </div>

            <button type="submit" class="login-btn" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner"></span>
                    <span>Signing in…</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </button>
        </EditForm>

    </div>
</div>

<style>
    .login-wrapper {
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f4f6f8;
        padding: 1.5rem;
    }

    .login-card {
        width: 100%;
        max-width: 400px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.07), 0 8px 24px rgba(0, 0, 0, 0.06);
        padding: 2.5rem 2.25rem;
        border: 1px solid #e8ecf0;
    }

    .login-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .brand-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 60px;
        height: 60px;
        background-color: #eef2f7;
        border-radius: 14px;
        color: #4a6fa5;
        margin-bottom: 1.1rem;
    }

    .login-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #1e2a3a;
        margin: 0 0 0.25rem 0;
        letter-spacing: -0.3px;
    }

    .login-subtitle {
        font-size: 0.875rem;
        color: #8a96a3;
        margin: 0;
        font-weight: 400;
        letter-spacing: 0.3px;
    }

    .login-form {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
    }

    .field-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .field-label {
        font-size: 0.82rem;
        font-weight: 500;
        color: #4a5568;
        letter-spacing: 0.1px;
    }

    .field-input {
        width: 100%;
        padding: 0.65rem 0.9rem;
        border: 1.5px solid #dce2ea;
        border-radius: 8px;
        font-size: 0.9rem;
        font-family: 'Inter', sans-serif;
        color: #2d3748;
        background-color: #fafbfc;
        transition: border-color 0.18s ease, box-shadow 0.18s ease;
        outline: none;
        box-sizing: border-box;
    }

    .field-input:focus {
        border-color: #4a6fa5;
        background-color: #fff;
        box-shadow: 0 0 0 3px rgba(74, 111, 165, 0.1);
    }

    .field-input::placeholder {
        color: #b0bac4;
        font-size: 0.875rem;
    }

    .password-wrapper {
        position: relative;
    }

    .password-wrapper .field-input {
        padding-right: 2.75rem;
    }

    .toggle-pass {
        position: absolute;
        right: 0.7rem;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: #a0aab4;
        display: flex;
        align-items: center;
        padding: 0;
        transition: color 0.15s;
    }

    .toggle-pass:hover {
        color: #4a6fa5;
    }

    .field-error {
        font-size: 0.78rem;
        color: #e05c5c;
        margin: 0;
    }

    .login-btn {
        margin-top: 0.5rem;
        width: 100%;
        padding: 0.75rem 1rem;
        background-color: #4a6fa5;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: background-color 0.2s ease, transform 0.1s ease;
        letter-spacing: 0.2px;
    }

    .login-btn:hover:not(:disabled) {
        background-color: #3d5d8f;
    }

    .login-btn:active:not(:disabled) {
        transform: scale(0.99);
    }

    .login-btn:disabled {
        background-color: #8fa8cc;
        cursor: not-allowed;
    }

    .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        display: inline-block;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    Login login = new Login();
    bool showPassword = false;
    bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await authStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var uri = navigationManager.ToAbsoluteUri(navigationManager.Uri);
            string targetUrl = "/";
            if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("ReturnUrl", out var returnUrl))
            {
                targetUrl = returnUrl!;
            }
            navigationManager.NavigateTo(targetUrl, forceLoad: true);
        }
    }

    public async Task _Login()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var respons = await accountService.Login(login);

            if (string.IsNullOrWhiteSpace(respons.AccessToken))
            {
                await JS.InvokeVoidAsync("showToast2", "Name Or Password Is Wrong");
                return;
            }

            await JS.InvokeVoidAsync("storage.setAccessToken", respons.AccessToken);
            await JS.InvokeVoidAsync("storage.setRefreshToken", respons.RefreshToken);

            if (authStateProvider is CustomAuthenticationStateProvider customProvider)
            {
                customProvider.MarkUserAsAuthenticated(respons.AccessToken);
            }

            var uri = navigationManager.ToAbsoluteUri(navigationManager.Uri);
            string targetUrl = "/";
            if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("ReturnUrl", out var returnUrl))
            {
                targetUrl = returnUrl!;
            }

            navigationManager.NavigateTo(targetUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showToast2", $"Connection error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}

