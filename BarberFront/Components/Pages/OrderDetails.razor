@page "/orderDetails/{id}"
@attribute [Authorize]
@inject OrderService OrderService
@inject IJSRuntime JS
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject BarberService BarberService
@inject NavigationManager Navigation
@inject ItemService ItemService

<div class="container py-4">

    <button class="btn btn-outline-secondary mb-4"
            @onclick="GoBack">
        <i class="bi bi-arrow-left"></i> Back
    </button>

    <div class="card shadow border-0">

        <div class="card-header bg-dark text-white">
            <h3 class="mb-0">
                <i class="bi bi-receipt"></i>
                Order Details
            </h3>
        </div>

        <div class="card-body">

            <div class="row text-center mb-4">

                <div class="col-md-4">
                    <div class="border rounded p-3">
                        <i class="bi bi-person-fill fs-2 text-primary"></i>
                        <h6 class="mt-2 mb-1">Barber</h6>
                        <h5>@orderMV.BarberName</h5>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded p-3">
                        <i class="bi bi-calendar-event fs-2 text-success"></i>
                        <h6 class="mt-2 mb-1">Date</h6>
                        <h5>@orderMV.Date.ToString("dd/MM/yyyy")</h5>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded p-3">
                        <i class="bi bi-cash-stack fs-2 text-warning"></i>
                        <h6 class="mt-2 mb-1">Total</h6>
                        <h4 class="text-success">@orderMV.TotalPrice.ToString("F2") EGP</h4>
                    </div>
                </div>

            </div>

            <h4 class="mb-3">
                <i class="bi bi-scissors"></i>
                Services
            </h4>
            @foreach (var item in orderMV.Items)
            {
                <div class="card mb-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-check-circle-fill text-success"></i>
                            @item.name
                        </div>

                        <span class="fw-bold">
                            @item.price.ToString("F2") EGP
                        </span>
                    </div>
                </div>
            }
            <hr>

            <div class="d-flex justify-content-between">

                <h4>Total</h4>

                <h3 class="text-success">
                    @orderMV.TotalPrice.ToString("F2") EGP
                </h3>

            </div>

        </div>

        <div class="card-footer text-end">

            <button class="btn btn-success me-2">
                <i class="bi bi-printer"></i>
                Print
            </button>

            <button class="btn btn-warning"  @onclick="ShowEditModal">
                <i class="bi bi-pencil-square" ></i>
                Edit
            </button>

        </div>

    </div>

</div>

@if (showEditModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h4>Edit Order</h4>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseModal">
                    </button>
                </div>

                <EditForm Model="@orderMV" OnValidSubmit="UpdateOrder">

                    <div class="modal-body">

                        <div class="mb-3">
                            <label>Barber</label>

                            <InputSelect class="form-select"
                                         @bind-Value="order.BarberId">

                                @foreach (var barber in barbers)
                                {
                                    <option value="@barber.Id">
                                        @barber.Name
                                    </option>
                                }

                            </InputSelect>
                        </div>

                        <hr />

                        <h5>Selected Services</h5>

                        @foreach (var item in order.orderItemDs)
                        {
                            <div class="d-flex justify-content-between border rounded p-2 mb-2">

                                <span>@item.Name</span>

                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        @onclick="() => Remove(item)">
                                    Remove
                                </button>
                              
                            </div>
                        }
                        
                             <div class="d-flex justify-content-between">

                              <h4>Total</h4>
    
                            <h3 class="text-success">
                            <i>@order.TotalPrice.ToString("F2") EGP</i>
                                </h3>

                            </div>
                        
                        <button type="button"
                                class="btn btn-primary mt-2"
                                @onclick="OpenAddService">
                            Add Service
                        </button>

                        
                        @if (showAddService)
                        {
                            <hr />

                            <div class="card border-primary">

                                <div class="card-header bg-primary text-white">
                                    Available Services
                                </div>
                                @foreach (var item in selectedItems)
                                {
                                    <div class="d-flex justify-content-between align-items-center border rounded p-3 mb-2">

                                        <div>
                                            <h6 class="mb-1">@item.Name</h6>
                                            <small class="text-muted">@item.Price.ToString("F2") EGP</small>
                                        </div>

                                        <button type="button"
                                                class="btn btn-success btn-sm"
                                                @onclick="() => AddItems(item)">
                                            <i class="bi bi-plus-circle"></i>
                                            Add
                                        </button>

                                    </div>
                                }

                                </div>
                        }


                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input type="password" class="form-control" @bind="checkAccess.pass" />
                            <ValidationMessage For="@(() => checkAccess.pass)" />
                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="CloseModal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-success">
                            Save Changes
                        </button>

                    </div>

                </EditForm>

            </div>
        </div>
    </div>
}



@code {
    [Parameter]
    public string id { get; set; } = string.Empty;

    OrderMV orderMV = new();
    List<BarberMV> barbers = new();
    public async Task LoadOrderDetails()
    {
        orderMV = await OrderService.GetOrderById(id);
        barbers = await BarberService.GetAllBarbers();
    }

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine(id);
        await LoadOrderDetails();
    }

    void GoBack()
    {
        Navigation.NavigateTo("/order");
    }


    bool showEditModal = false;

    OrderD order = new();
    public void ShowEditModal()
    {
        showEditModal = true;
        order.BarberId = orderMV.BarberId;
        order.TotalPrice = orderMV.TotalPrice;
        foreach (var item in orderMV.Items)
        {
            order.orderItemDs.Add(new OrderItemD()
            {
                Name = item.name,
                Price = item.price
            });
        }

    }


    public void CloseModal()
    {
        showEditModal = false;
        showAddService = false;
        order.orderItemDs.Clear();
        checkAccess = new CheckAccess();
    }

    public async Task Remove(OrderItemD item)
    {
        order.orderItemDs.Remove(item);
        order.TotalPrice -= item.Price;
        await FilterItems();
    }

    CheckAccess checkAccess = new CheckAccess();

    public async Task UpdateOrder()
    {
        await JS.InvokeVoidAsync("showLoading");
        var result = await OrderService.EditOrder(order, id, checkAccess);
        await JS.InvokeVoidAsync("hideLoading");

        if (result.Status)
        {
            await LoadOrderDetails();
            CloseModal();
            checkAccess = new CheckAccess();
            await JS.InvokeVoidAsync("showToast", result.StatusMessage);
        }
        else
        {
            await JS.InvokeVoidAsync("showToast2", result.StatusMessage);
        }

    }

    bool showAddService = false;
    List<ItemMV> itemsToDisplay = new();
    List<ItemMV> selectedItems = new();
    async Task OpenAddService()
    {
        showAddService = true;
        await FilterItems();

    }

    public async Task FilterItems()
    {
        itemsToDisplay = await ItemService.GetAllItems();
        foreach (var item in order.orderItemDs)
        {
            var itemToRemove = itemsToDisplay.FirstOrDefault(i => i.Name == item.Name);
            if (itemToRemove != null)
            {
                itemsToDisplay.Remove(itemToRemove);
            }
        }
        selectedItems = itemsToDisplay.ToList();
    }

    public async Task AddItems(ItemMV item)
    {
        order.orderItemDs.Add(new OrderItemD()
        {
            Name = item.Name,
            Price = item.Price
        });
        order.TotalPrice += item.Price;
        await FilterItems();
        
    }



}
