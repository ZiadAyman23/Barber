@page "/account"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AccountService accountService
@inject AuthenticationStateProvider authStateProvider
@inject IJSRuntime JS

<div class="container py-4">

    <!-- Page Header -->
    <div class="row align-items-center mb-4">
        <div class="col">
            <h2 class="fw-bold text-dark d-flex align-items-center gap-2 mb-1">
                <i class="bi bi-person-circle text-primary"></i> إعدادات الحساب
            </h2>
            <p class="text-muted mb-0">
                إدارة بيانات الحساب وتغيير كلمة السر الخاصة بك.
            </p>
        </div>
    </div>

    <div class="row g-4">
        <!-- User Info Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <div class="card-body d-flex flex-column align-items-center justify-content-center">
                    <div class="avatar-circle mb-3 shadow-sm">
                        <i class="bi bi-person-fill fs-1 text-primary"></i>
                    </div>

                    <h4 class="fw-bold text-dark mb-1">@(string.IsNullOrWhiteSpace(userName) ? "المستخدم" : userName)</h4>
                    <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill mb-3">
                        <i class="bi bi-shield-lock me-1"></i> مدير النظام
                    </span>

                    @if (!string.IsNullOrWhiteSpace(userEmail) && userEmail != "Not Found")
                    {
                        <div class="text-muted small d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-envelope"></i>
                            <span>@userEmail</span>
                        </div>
                    }

                    <div class="w-100 border-top pt-3 mt-3 text-start">
                        <div class="d-flex justify-content-between text-muted small py-1">
                            <span>حالة الحساب:</span>
                            <span class="text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>نشط</span>
                        </div>
                        <div class="d-flex justify-content-between text-muted small py-1">
                            <span>الأمان:</span>
                            <span class="text-primary fw-semibold">محمي بكلمة مرور</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Change Password Card -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-4">
                <div class="card-body p-0">
                    <div class="d-flex align-items-center gap-2 border-bottom pb-3 mb-4">
                        <i class="bi bi-key-fill text-warning fs-4"></i>
                        <h4 class="fw-bold mb-0 text-dark">تغيير كلمة السر</h4>
                    </div>

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <div>@successMessage</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            <div>@errorMessage</div>
                        </div>
                    }

                    <EditForm Model="@changePasswordModel" OnValidSubmit="HandleChangePassword">
                        <DataAnnotationsValidator />

                        <!-- Current Password -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">كلمة المرور الحالية <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-lock text-muted"></i>
                                </span>
                                <input type="@(showOldPassword ? "text" : "password")"
                                       class="form-control border-start-0 border-end-0"
                                       placeholder="أدخل كلمة المرور الحالية"
                                       @bind="changePasswordModel.OldPassword" />
                                <button type="button" class="btn btn-outline-secondary border-start-0" @onclick="() => showOldPassword = !showOldPassword">
                                    <i class="bi @(showOldPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                            <ValidationMessage For="@(() => changePasswordModel.OldPassword)" class="text-danger small mt-1" />
                        </div>

                        <!-- New Password -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">كلمة المرور الجديدة <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-shield-lock text-muted"></i>
                                </span>
                                <input type="@(showNewPassword ? "text" : "password")"
                                       class="form-control border-start-0 border-end-0"
                                       placeholder="أدخل كلمة المرور الجديدة (6 أحرف على الأقل)"
                                       @bind="changePasswordModel.NewPassword" />
                                <button type="button" class="btn btn-outline-secondary border-start-0" @onclick="() => showNewPassword = !showNewPassword">
                                    <i class="bi @(showNewPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                            <ValidationMessage For="@(() => changePasswordModel.NewPassword)" class="text-danger small mt-1" />
                        </div>

                        <!-- Confirm New Password -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark">تأكيد كلمة المرور الجديدة <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-shield-check text-muted"></i>
                                </span>
                                <input type="@(showConfirmPassword ? "text" : "password")"
                                       class="form-control border-start-0 border-end-0"
                                       placeholder="أعد إدخال كلمة المرور الجديدة"
                                       @bind="changePasswordModel.ConfirmPassword" />
                                <button type="button" class="btn btn-outline-secondary border-start-0" @onclick="() => showConfirmPassword = !showConfirmPassword">
                                    <i class="bi @(showConfirmPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                            <ValidationMessage For="@(() => changePasswordModel.ConfirmPassword)" class="text-danger small mt-1" />
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary px-4" @onclick="ResetForm" disabled="@isSubmitting">
                                إلغاء
                            </button>
                            <button type="submit" class="btn btn-primary px-4 d-flex align-items-center gap-2" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>جارٍ التحديث...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-lg"></i>
                                    <span>حفظ كلمة المرور</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        background: #eef2ff;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 3px solid #ffffff;
    }
</style>

@code {
    private ChangePassword changePasswordModel = new();
    private string userName = "";
    private string userEmail = "";
    private bool isSubmitting = false;
    private string successMessage = "";
    private string errorMessage = "";

    private bool showOldPassword = false;
    private bool showNewPassword = false;
    private bool showConfirmPassword = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await authStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            userName = user.Identity.Name ?? "";
            userEmail = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
        }
    }

    private async Task HandleChangePassword()
    {
        isSubmitting = true;
        successMessage = "";
        errorMessage = "";

        try
        {
            await JS.InvokeVoidAsync("showLoading");
            var result = await accountService.ChangePassword(changePasswordModel);
            await JS.InvokeVoidAsync("hideLoading");

            if (result.Status)
            {
                successMessage = result.StatusMessage;
                await JS.InvokeVoidAsync("showToast", result.StatusMessage);
                ResetForm();
            }
            else
            {
                errorMessage = result.StatusMessage;
                await JS.InvokeVoidAsync("showToast2", result.StatusMessage);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("hideLoading");
            errorMessage = $"حدث خطأ أثناء تغيير كلمة المرور: {ex.Message}";
            await JS.InvokeVoidAsync("showToast2", errorMessage);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        changePasswordModel = new ChangePassword();
        showOldPassword = false;
        showNewPassword = false;
        showConfirmPassword = false;
    }
}
