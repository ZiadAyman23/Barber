@page "/deduction"
@attribute [Authorize]
@inject BarberService barberService
@inject DeductionService deductionService
@inject IJSRuntime JS
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="container mt-4 deduction-page">

    <div class="row align-items-center mb-4">

        <div class="col">

            <p class="page-kicker">رواتب الفريق</p>
            <h2 class="fw-bold text-dark">الخصومات</h2>

            <p class="text-muted mb-0">
                راجع وأدر خصومات رواتب فريقك.
            </p>

        </div>

        <div class="col-auto">

            <button class="btn btn-success px-4" @onclick="OpenAdd">
                إضافة خصم
            </button>


        </div>

     
    </div>
    <div class="deduction-filter">
        <div>
        <label class="form-label">التصفية حسب التاريخ</label>
        <InputDate @bind-Value="selectedDate"
                   max="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")"
                   class="form-control" />
        </div>
        <button class="btn btn-primary" @onclick="GitByDate">بحث</button>
        <button class="btn btn-outline-secondary" @onclick="LoadDeduction">
            عرض الكل
        </button>
    </div>

</div>

<div class="container deduction-content">

    <div class="card border-0 shadow-sm overflow-hidden">
    <table class="table mb-0">
        <thead>

            <tr>
                <th scope="col">الحلاق</th>
                <th scope="col">المبلغ</th>
                <th scope="col">السبب</th>
                <th scope="col">أُنشئ بواسطة</th>
                <th scope="col">التاريخ</th>
                <th scope="col" class="text-end">الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var _item in deductionMVs)
            {
                <tr>
                    <td class="fw-semibold text-dark">@_item.BaeberName</td>
                    <td><span class="badge bg-light text-dark border px-3 py-2">@_item.Amount.ToString("N2") EGP</span></td>
                    <td>@_item.Reason</td>
                    <td>@_item.CreatedBy</td>
                    <td>@_item.DateOnly</td>
                  
                    <td class="text-end text-nowrap">
                        <button class="btn btn-sm btn-primary me-2"
                                @onclick="@(() => openEdit(_item))">
                            تعديل
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => openRemove(_item.id)">حذف</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    @if (!hideNextButton)
    {
    
        <div class="d-flex justify-content-center mt-3">
            <button class="btn btn-outline-secondary" @onclick="PreviousPage">السابق</button>
            <button class="btn btn-outline-secondary"  @onclick="NextPage">التالي</button>
        </div>
    }
</div>


@if (showAdd)
{
    <div class="modal fade show d-block"
         style="background-color:rgba(0,0,0,.5)">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5>إضافة خصم</h5>
                    <button class="btn-close"
                            @onclick="closeAdd">
                    </button>
                </div>

                <div class="modal-body">

                    <EditForm Model="@deductionD" OnValidSubmit="AddDeduction">

                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">
                                الحلاق
                            </label>

                            <InputSelect class="form-control"
                                         @bind-Value="deductionD.BarberId" >
                            <option value="">-- Select Barber --</option>

                            @foreach (var barber in barberDs)
                            {
                                <option value="@barber.Id">@barber.Name</option>
                            }
                            </InputSelect>

                            <ValidationMessage For="@(() => deductionD.BarberId)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                المبلغ
                            </label>

                            <InputNumber class="form-control"
                                         @bind-Value="deductionD.Amount" />

                            <ValidationMessage For="@(() => deductionD.Amount)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                السبب
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="deductionD.Reason" />

                            <ValidationMessage For="@(() => deductionD.Reason)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                أُنشئ بواسطة
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="deductionD.CreatedBy" />

                            <ValidationMessage For="@(() => deductionD.CreatedBy)" />
                        </div>

                        <div class="text-end">
                            <button type="button"
                                    class="btn btn-secondary me-2"
                                    @onclick="closeAdd">
                                إلغاء
                            </button>

                            <button type="submit"
                                    class="btn btn-success">
                                إضافة
                            </button>
                        </div>

                    </EditForm>

                </div>

            </div>
        </div>
    </div>
}




@if (showEdit)
{
    <div class="modal fade show d-block"
         style="background-color:rgba(0,0,0,.5)">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5>تعديل خصم</h5>
                    <button class="btn-close"
                            @onclick="closeEdit">
                    </button>
                </div>

                <div class="modal-body">

                    <EditForm Model="@deductionD" OnValidSubmit="Edit">

                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">
                                Barber
                            </label>

                            <InputSelect class="form-control"
                                         @bind-Value="deductionD.BarberId">
                                <option value="">-- Select Barber --</option>

                                @foreach (var barber in barberDs)
                                {
                                    <option value="@barber.Id">@barber.Name</option>
                                }
                            </InputSelect>

                            <ValidationMessage For="@(() => deductionD.BarberId)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Amount
                            </label>

                            <InputNumber class="form-control"
                                         @bind-Value="deductionD.Amount" />

                            <ValidationMessage For="@(() => deductionD.Amount)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Reason
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="deductionD.Reason" />

                            <ValidationMessage For="@(() => deductionD.Reason)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Created By
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="deductionD.CreatedBy" />

                            <ValidationMessage For="@(() => deductionD.CreatedBy)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input type="password" class="form-control" @bind="checkAccessEdit.pass" />
                            <ValidationMessage For="@(() => checkAccessEdit.pass)" />
                        </div>

                        <div class="text-end">
                            <button type="button"
                                    class="btn btn-secondary me-2"
                                    @onclick="closeEdit">
                                Cancel
                            </button>

                            <button type="submit"
                                    class="btn btn-success">
                                Save
                            </button>
                        </div>

                    </EditForm>

                </div>

            </div>
        </div>
    </div>
}

<style>
    .page-kicker { color:#2563eb; font-size:.72rem; font-weight:700; letter-spacing:.1em; margin-bottom:.3rem; text-transform:uppercase; }
    .deduction-filter { display:flex; align-items:end; gap:.65rem; padding:1rem; border:1px solid #e2e8f0; border-radius:14px; background:#fff; box-shadow:0 3px 12px rgb(15 23 42 / .04); }
    .deduction-filter .form-label { margin-bottom:.35rem; }
    .deduction-content { padding-bottom:2rem; }
    @@media (max-width:640px) { .deduction-filter { align-items:stretch; flex-direction:column; } .deduction-filter .btn { width:100%; } }
</style>


@if (showRemove)
{
    <div class="modal fade show d-block"
         style="background-color:rgba(0,0,0,.5)">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5>حذف خصم</h5>
                    <button class="btn-close"
                            @onclick="closeRemove">
                    </button>
                </div>

                <div class="modal-body">

                    <EditForm Model="@checkAccess" OnValidSubmit="Remove">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input type="password" class="form-control" @bind="checkAccess.pass" />
                            <ValidationMessage For="@(() => checkAccess.pass)" />
                        </div>

                        <div class="text-end">
                            <button type="button" class="btn btn-secondary me-2"
                                    @onclick="closeRemove">
                                Cancel
                            </button>

                            <button type="submit" class="btn btn-danger">
                                Delete
                            </button>
                        </div>
                    </EditForm>

                </div>

            </div>
        </div>
    </div>
}




@code {

    bool hideNextButton = false;
    DateTime selectedDate = DateTime.Now;
    List<DeductionMV> deductionMVs = new List<DeductionMV>();
    Pagenation pagenation = new Pagenation { PageNumber = 1, PageSize = 10 };
    List<BarberMV> barberDs = new List<BarberMV>();

    public async Task LoadDeduction()
    {
        deductionMVs = await deductionService.GetAllDeduction(pagenation);
        barberDs = await barberService.GetAllBarbers();
        hideNextButton = false;


    }
    protected override async Task OnInitializedAsync()
    {

        await LoadDeduction();
    }
    public void nextPag()
    { }

    public void previousPag()
    { }

    //----------Add

    bool showAdd=false;
    DeductionD deductionD = new DeductionD();

    public void OpenAdd()
    {

        showAdd = true;
    }

    public void closeAdd()
    {
        showAdd = false;
        deductionD = new DeductionD();
    }

    public async Task AddDeduction()
    {
        await JS.InvokeVoidAsync("showLoading");
        var respons = await deductionService.AddDeductionAsync(deductionD);
        await JS.InvokeVoidAsync("hideLoading");

        showAdd = false;

        pagenation.PageNumber = 1;
        await LoadDeduction();

        deductionD = new DeductionD();
        if(!respons.Status)
        {
            await JS.InvokeVoidAsync("showToast2", respons.StatusMessage);
            return;
        }

        await JS.InvokeVoidAsync("showToast", respons.StatusMessage);


    }

    //-Edit----------------------------
    bool showEdit = false;
    string deductionID = string.Empty;
    CheckAccess checkAccessEdit = new CheckAccess();
    public void openEdit(DeductionMV deductionMV)
    {
        deductionD.Amount = deductionMV.Amount;
        deductionD.CreatedBy = deductionMV.CreatedBy;
        deductionD.Reason = deductionMV.Reason;
        deductionD.BarberId = deductionMV.BarberId;
        deductionID = deductionMV.id;
        checkAccessEdit = new CheckAccess();
        showEdit = true;

    }
    public void closeEdit()
    {
        showEdit = false;
        deductionD = new DeductionD();
        checkAccessEdit = new CheckAccess();

    }
    public async Task Edit()
    {

        await JS.InvokeVoidAsync("showLoading");
        var respons = await deductionService.EditDeduction(deductionD,deductionID, checkAccessEdit);
        await JS.InvokeVoidAsync("hideLoading");

        if(!respons.Status)
        {
            await JS.InvokeVoidAsync("showToast2", respons.StatusMessage);
            showEdit = false;
            return;
        }

        await LoadDeduction();
        showEdit = false;
        deductionD = new DeductionD();
        checkAccessEdit = new CheckAccess();

        await JS.InvokeVoidAsync("showToast", respons.StatusMessage);

    }

    //Remove----------------

    bool showRemove =false;
    CheckAccess checkAccess = new CheckAccess();

    public void openRemove(string id)
    {
        deductionID =id;
        checkAccess = new CheckAccess();
        showRemove = true;

    }
    public void closeRemove()
    {
        showRemove = false;
        checkAccess = new CheckAccess();

    }
    public async Task Remove()
    {

        await JS.InvokeVoidAsync("showLoading");
        var respons = await deductionService.RemoveDeductionAsync(deductionID, checkAccess);
        await JS.InvokeVoidAsync("hideLoading");

        showRemove = false;

        await LoadDeduction();

        deductionD = new DeductionD();
        checkAccess = new CheckAccess();
        if (!respons.Status)
        {
            await JS.InvokeVoidAsync("showToast2", respons.StatusMessage);
            return;
        }

        await JS.InvokeVoidAsync("showToast", respons.StatusMessage);


    }


    //---search
    public async Task GitByDate()
    {

        await JS.InvokeVoidAsync("showLoading");
        deductionMVs = await deductionService.GetDateDeductionAsync(selectedDate);

        await JS.InvokeVoidAsync("hideLoading");

        if (deductionMVs.Count == 0)
        {
            await JS.InvokeVoidAsync("showToast3", $"لا توجد خصومات لهذا اليوم {selectedDate}");
            return;
        }

        await JS.InvokeVoidAsync("showToast", $"خصومات يوم {selectedDate}");

        hideNextButton = true;

    }


    public async Task NextPage()
    {
        pagenation.PageNumber++;
        await  LoadDeduction();
        if (deductionMVs.Count == 0)
        {
            pagenation.PageNumber--;
            await LoadDeduction();
           
            await JS.InvokeVoidAsync("showToast3", "لا توجد المزيد من الخصومات");
            return;
        }

    }

    public async Task PreviousPage()
    {
        if (pagenation.PageNumber == 1)
        {
            await JS.InvokeVoidAsync("showToast3", "أنت بالفعل في الصفحة الأولى");
            return;
        }
        pagenation.PageNumber--;
        await LoadDeduction();
    }




}
