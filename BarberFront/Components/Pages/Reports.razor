@page "/reports"
@attribute [Authorize]
@inject MonthelyReportServ monthelyReportServ
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="reports-page">
    <header class="reports-header">
        <div>
            <p class="reports-eyebrow">نظرة عامة على النشاط</p>
            <h1>التقارير الشهرية</h1>
            <p class="reports-subtitle">تابع المبيعات والتكاليف وأداء فريقك في مكان واحد.</p>
        </div>

        @if (HasReport)
        {
            <div class="report-header-actions">
                <div class="report-period">
                    <span class="period-dot"></span>
                    @MonthName(monthelyReportMV.month) @monthelyReportMV.Year
                </div>
                <div class="report-export-actions" data-pdf-exclude="true">
                    <button type="button" class="report-action" @onclick="ExportPdf">تصدير PDF</button>
                    <button type="button" class="report-action" @onclick="PrintReport">طباعة</button>
                </div>
            </div>
        }
    </header>

    <section class="report-filter" aria-label="Report period">
        <div class="filter-field">
            <label for="report-month">الشهر</label>
            <InputSelect id="report-month" @bind-Value="selectedMonth" class="report-select">
                @foreach (var month in Enum.GetValues<MonthelyReportMV.Month>())
                {
                    <option value="@month">@MonthName(month)</option>
                }
            </InputSelect>
        </div>
        <div class="filter-field">
            <label for="report-year">السنة</label>
            <InputNumber id="report-year" @bind-Value="selectedYear" class="report-input" />
        </div>
        <button class="report-button" @onclick="GenerateReport">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/></svg>
            إنشاء التقرير
        </button>
    </section>

    @if (HasReport)
    {
        <section class="report-summary" aria-label="Monthly summary">
            <div class="summary-intro">
                <div>
                    <p class="section-label">الملخص المالي</p>
                    <h2>نظرة سريعة على شهر @monthelyReportMV.month</h2>
                </div>
                <div class="profit-callout @(monthelyReportMV.Profit >= 0 ? "positive" : "negative")">
                    <span>صافي الربح</span>
                    <strong>@Money(monthelyReportMV.Profit)</strong>
                </div>
            </div>

            <div class="metrics-grid">
                <article class="metric-card metric-sales">
                    <div class="metric-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="m7 16 4-5 3 3 6-8"/></svg></div>
                    <span>إجمالي المبيعات</span>
                    <strong>@Money(monthelyReportMV.totalSales)</strong>
                </article>
                <article class="metric-card metric-orders">
                    <div class="metric-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></div>
                    <span>إجمالي الطلبات</span>
                    <strong>@monthelyReportMV.orders</strong>
                </article>
                <article class="metric-card metric-salary">
                    <div class="metric-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="7" r="4"/><path d="M5.5 21a6.5 6.5 0 0 1 13 0"/></svg></div>
                    <span>رواتب الفريق</span>
                    <strong>@Money(monthelyReportMV.TotalSalaries)</strong>
                </article>
                <article class="metric-card metric-expense">
                    <div class="metric-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2h12l3 5-9 15L3 7l3-5Z"/><path d="M3 7h18M9 2l3 5 3-5"/></svg></div>
                    <span>المصروفات التشغيلية</span>
                    <strong>@Money(monthelyReportMV.TotalExpenses)</strong>
                </article>
            </div>

            <div class="deductions-row">
                <span>خصومات الموظفين</span>
                <strong>@Money(monthelyReportMV.TotalDeductions)</strong>
            </div>
            <section class="report-chart" aria-label="التوزيع المالي">
                <div class="chart-heading">
                    <div>
                        <p class="section-label">التوزيع المالي</p>
                        <h2>رحلة الربح خلال الشهر</h2>
                    </div>
                    <span class="chart-unit">القيم بالجنيه المصري</span>
                </div>
                <div class="finance-chart-wrap">
                    <canvas id="monthly-finance-chart" aria-label="رسم بياني للمبيعات والتكاليف وصافي الربح"></canvas>
                </div>
            </section>
        </section>

        <section class="barbers-section">
            <div class="section-heading">
                <div>
                    <p class="section-label">أداء الفريق</p>
                    <h2>تقرير الحلاقين</h2>
                </div>
                <span class="team-count">@monthelyReportMV.Barbers.Count حلاق</span>
            </div>

            @if (monthelyReportMV.Barbers.Count > 0)
            {
                <div class="report-table-wrap">
                    <table class="report-table">
                        <thead><tr><th>الحلاق</th><th>الطلبات</th><th>الحضور</th><th>الراتب الأساسي</th><th>الخصومات</th><th>صافي الراتب</th></tr></thead>
                        <tbody>
                            @foreach (var barber in monthelyReportMV.Barbers)
                            {
                                <tr>
                                    <td><div class="barber-cell"><span class="barber-avatar">@Initial(barber.BarberName)</span><strong>@barber.BarberName</strong></div></td>
                                    <td>@barber.BarberOrder</td>
                                    <td>@barber.BarberAttendance يوم</td>
                                    <td>@Money(barber.BarberSalaries)</td>
                                    <td class="deduction-value">-@Money(barber.BarberDeduction)</td>
                                    <td><strong class="net-salary">@Money(barber.BarberNetSalaries)</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-report"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg><p>No barber data is available for this period.</p></div>
            }
        </section>
    }
    else
    {
        <section class="report-empty-state">
            <div class="empty-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 19.5V4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v15.5"/><path d="M8 7h8M8 11h8M8 15h4"/><path d="M2 20h20"/></svg></div>
            <h2>تقريرك جاهز عند اختيار الفترة</h2><p>اختر الشهر والسنة من الأعلى، ثم أنشئ التقرير.</p>
        </section>
    }
</div>

<style>
    .reports-page { --ink:#1e293b; --muted:#64748b; --line:#e2e8f0; --blue:#2563eb; --soft-blue:#eff6ff; font-family:inherit; min-height:100vh; background:#f8fafc; padding:2rem clamp(1rem,3vw,3rem) 3rem; color:var(--ink); }
    .reports-header,.summary-intro,.section-heading,.report-filter,.deductions-row { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
    .reports-header { margin-bottom:1.75rem; } .reports-eyebrow,.section-label { color:var(--blue); font-size:.72rem; font-weight:700; letter-spacing:.1em; margin:0 0 .35rem; text-transform:uppercase; } h1,h2,p { margin-top:0; } h1 { font-size:clamp(1.6rem,3vw,2.1rem); letter-spacing:-.045em; margin-bottom:.35rem; } h2 { font-size:1.16rem; letter-spacing:-.025em; margin-bottom:0; } .reports-subtitle { color:var(--muted); margin-bottom:0; } .report-period,.team-count { display:inline-flex; align-items:center; gap:.5rem; white-space:nowrap; background:#fff; border:1px solid var(--line); border-radius:999px; padding:.55rem .8rem; color:#475569; font-size:.84rem; font-weight:600; } .period-dot { width:.45rem; height:.45rem; background:#22c55e; border-radius:50%; }
    .report-header-actions,.report-export-actions { display:flex; align-items:center; flex-wrap:wrap; gap:.5rem; } .report-action { background:#fff; border:1px solid var(--line); border-radius:8px; color:#334155; cursor:pointer; font-family:inherit; font-size:.78rem; font-weight:600; padding:.53rem .7rem; } .report-action:hover { border-color:#93c5fd; color:#1d4ed8; background:#eff6ff; }
    .report-filter { justify-content:flex-start; background:#fff; padding:1rem; border:1px solid var(--line); border-radius:14px; box-shadow:0 1px 2px rgb(15 23 42 / .03); margin-bottom:1.5rem; } .filter-field { min-width:170px; } .filter-field label { display:block; color:#475569; font-size:.75rem; font-weight:700; margin:0 0 .38rem; } .report-select,.report-input { width:100%; border:1px solid #cbd5e1; border-radius:8px; background:#fff; color:var(--ink); font:inherit; padding:.58rem .7rem; outline:none; } .report-select:focus,.report-input:focus { border-color:#60a5fa; box-shadow:0 0 0 3px #dbeafe; } .report-button { align-self:end; display:inline-flex; align-items:center; justify-content:center; gap:.5rem; border:0; border-radius:8px; background:var(--blue); color:#fff; cursor:pointer; font:600 .85rem Inter,system-ui,sans-serif; padding:.66rem 1rem; transition:.15s ease; } .report-button:hover { background:#1d4ed8; transform:translateY(-1px); } .report-button svg { width:16px; height:16px; }
    .report-summary,.barbers-section { background:#fff; border:1px solid var(--line); border-radius:14px; padding:clamp(1rem,2vw,1.5rem); box-shadow:0 1px 2px rgb(15 23 42 / .03); } .profit-callout { min-width:155px; border-radius:10px; padding:.7rem .85rem; } .profit-callout span { display:block; font-size:.72rem; font-weight:600; opacity:.8; margin-bottom:.15rem; } .profit-callout strong { font-size:1rem; } .positive { color:#047857; background:#ecfdf5; } .negative { color:#b91c1c; background:#fef2f2; }
    .metrics-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1rem; margin-top:1.3rem; } .metric-card { min-width:0; border:1px solid var(--line); border-radius:11px; padding:1rem; } .metric-card span { display:block; color:var(--muted); font-size:.77rem; font-weight:600; margin:.7rem 0 .25rem; } .metric-card strong { display:block; font-size:clamp(1rem,1.7vw,1.35rem); letter-spacing:-.03em; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; } .metric-icon { width:30px; height:30px; display:grid; place-items:center; border-radius:8px; } .metric-icon svg { width:16px; height:16px; } .metric-sales .metric-icon { color:#2563eb;background:#eff6ff; } .metric-orders .metric-icon { color:#7c3aed;background:#f5f3ff; } .metric-salary .metric-icon { color:#c2410c;background:#fff7ed; } .metric-expense .metric-icon { color:#be123c;background:#fff1f2; }
    .deductions-row { margin-top:1rem; padding:.75rem .9rem; border-radius:9px; background:#f8fafc; color:#64748b; font-size:.82rem; } .deductions-row strong { color:#334155; }
    .report-chart { margin-top:1.25rem; padding-top:1.25rem; border-top:1px solid #eef2f7; } .chart-heading { display:flex; align-items:start; justify-content:space-between; gap:1rem; margin-bottom:1rem; } .chart-unit { color:var(--muted); font-size:.75rem; } .finance-chart-wrap { position:relative; height:310px; padding:1rem .75rem .5rem; border-radius:12px; background:linear-gradient(135deg,#f8fafc 0%,#fff 100%); border:1px solid #eef2f7; }
    .barbers-section { margin-top:1.5rem; } .section-heading { margin-bottom:1.2rem; } .team-count { font-size:.75rem; } .report-table-wrap { overflow-x:auto; } .report-table { width:100%; border-collapse:collapse; min-width:720px; direction:rtl; } .report-table th { color:#64748b; font-size:.7rem; font-weight:700; letter-spacing:.06em; text-align:right; padding:0 .75rem .7rem; } .report-table td { border-top:1px solid #eef2f7; color:#475569; font-size:.85rem; padding:.9rem .75rem; text-align:right; vertical-align:middle; white-space:nowrap; } .report-table th:not(:first-child),.report-table td:not(:first-child) { text-align:center; } .barber-cell { color:var(--ink); display:flex; align-items:center; justify-content:flex-start; gap:.65rem; } .barber-avatar { display:inline-grid; place-items:center; width:30px; height:30px; border-radius:50%; background:#e0e7ff; color:#4338ca; font-size:.75rem; font-weight:700; } .deduction-value { color:#b45309!important; } .net-salary { color:#047857; } .empty-report { display:flex; align-items:center; gap:.75rem; padding:1.6rem; border:1px dashed #cbd5e1; border-radius:10px; color:var(--muted); font-size:.88rem; } .empty-report svg { width:22px; height:22px; } .empty-report p { margin:0; }
    .report-empty-state { max-width:460px; text-align:center; padding:4.5rem 1.5rem; margin:3rem auto 0; } .empty-icon { display:grid; place-items:center; width:54px; height:54px; border-radius:15px; background:var(--soft-blue); color:var(--blue); margin:0 auto 1rem; } .empty-icon svg { width:28px; height:28px; } .report-empty-state h2 { font-size:1.1rem; margin-bottom:.4rem; } .report-empty-state p { color:var(--muted); font-size:.88rem; margin-bottom:0; }
    @@media (max-width:850px) { .metrics-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } } @@media (max-width:600px) { .reports-page { padding:1.25rem 1rem 2rem; } .reports-header,.summary-intro { align-items:flex-start; flex-direction:column; } .report-filter { align-items:stretch; flex-direction:column; } .filter-field { min-width:0; } .report-button { align-self:stretch; } .profit-callout { width:100%; } .metrics-grid { gap:.7rem; } .report-header-actions { width:100%; } .chart-row { grid-template-columns:70px minmax(60px,1fr); } .chart-row strong { grid-column:2; } } @@media print { .report-filter,.report-header-actions { display:none!important; } .reports-page { background:#fff; padding:0; } .report-summary,.barbers-section { box-shadow:none; } }
</style>

@code {
    public int selectedYear = DateOnly.FromDateTime(DateTime.Now).Year;
    public MonthelyReportMV.Month selectedMonth = (MonthelyReportMV.Month)DateTime.Now.Month;
    MonthelyReportMV monthelyReportMV = new();
    bool HasReport => monthelyReportMV.Year != 0;

    async Task GenerateReport()
    {
        await JS.InvokeVoidAsync("showLoading");
        try
        {
            monthelyReportMV = await monthelyReportServ.GenratMonthReport((int)selectedMonth, selectedYear);
            renderFinanceChart = HasReport;
        }
        finally { await JS.InvokeVoidAsync("hideLoading"); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!renderFinanceChart)
            return;

        renderFinanceChart = false;
        await JS.InvokeVoidAsync("renderMonthlyFinanceChart", new
        {
            sales = monthelyReportMV.totalSales,
            salaries = monthelyReportMV.TotalSalaries,
            expenses = monthelyReportMV.TotalExpenses,
            deductions = monthelyReportMV.TotalDeductions,
            profit = monthelyReportMV.Profit
        });
    }

    static string Money(decimal value) => $"{value:N2} ج.م";
    static string Initial(string? name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();
    static string MonthName(MonthelyReportMV.Month month) => month switch
    {
        MonthelyReportMV.Month.January => "يناير", MonthelyReportMV.Month.February => "فبراير", MonthelyReportMV.Month.March => "مارس",
        MonthelyReportMV.Month.April => "أبريل", MonthelyReportMV.Month.May => "مايو", MonthelyReportMV.Month.June => "يونيو",
        MonthelyReportMV.Month.July => "يوليو", MonthelyReportMV.Month.August => "أغسطس", MonthelyReportMV.Month.September => "سبتمبر",
        MonthelyReportMV.Month.October => "أكتوبر", MonthelyReportMV.Month.November => "نوفمبر", _ => "ديسمبر"
    };

    bool renderFinanceChart;

    async Task PrintReport() => await JS.InvokeVoidAsync("print");

    async Task ExportPdf()
    {
        try
        {
            await JS.InvokeVoidAsync("exportMonthlyReportPdf", $"Monthly-Report-{selectedMonth}-{selectedYear}.pdf", new
            {
                month = monthelyReportMV.month.ToString(),
                year = monthelyReportMV.Year,
                sales = monthelyReportMV.totalSales,
                orders = monthelyReportMV.orders,
                salaries = monthelyReportMV.TotalSalaries,
                expenses = monthelyReportMV.TotalExpenses,
                deductions = monthelyReportMV.TotalDeductions,
                profit = monthelyReportMV.Profit,
                barbers = monthelyReportMV.Barbers.Select(barber => new
                {
                    name = barber.BarberName,
                    orders = barber.BarberOrder,
                    attendance = barber.BarberAttendance,
                    salary = barber.BarberSalaries,
                    deductions = barber.BarberDeduction,
                    netSalary = barber.BarberNetSalaries
                })
            });
        }
        catch
        {
            await JS.InvokeVoidAsync("showToast2", "تعذر تصدير التقرير PDF.");
        }
    }

}
