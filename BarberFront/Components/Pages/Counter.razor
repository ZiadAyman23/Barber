@page "/counter"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>العداد</PageTitle>

<h1>العداد</h1>

<p role="status">العدد الحالي: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">زيادة العدد</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
